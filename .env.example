# Groq API anahtari — https://console.groq.com/keys adresinden alinir
GROQ_API_KEY=

# Neon PostgreSQL baglanti adresi
# Format: postgresql://kullanici:sifre@host/neondb?sslmode=require
DATABASE_URL=

# Fernet sifreleme anahtari — bir kez uretilir, SONRADAN DEGISTIRILMEZ!
# Uretmek icin:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bu anahtar kaybolursa veritabanindaki tum belgeler cozulemez hale gelir.
ENCRYPTION_KEY=

# Flask oturum/flash mesaj anahtari
# Uretmek icin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opsiyonel: kullanilacak Groq modeli (varsayilan: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Opsiyonel: Tesseract PATH'te degilse tam yolu
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Opsiyonel: kullanici basina en fazla belge sayisi (varsayilan: 50)
# KULLANICI_BELGE_LIMITI=50
