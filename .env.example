# ArcBase ayarlari. Bu dosyayi kopyalayip adini ".env" yapin ve degerleri doldurun.
# ".env" git'e girmez; gercek anahtar/sifre yalnizca orada durur, bu dosyaya ASLA yazilmaz.
# Yorum satiri (#) olan ayarlar istege baglidir; kullanmak icin "#" isaretini silin.

# ======================================================================
# ORTAK — her iki modda da gerekli
# ======================================================================

# Groq API anahtari — https://console.groq.com/keys adresinden alinir.
# Bos birakilirsa uygulama calisir; belge turu "Diger" olur (elle secilir).
GROQ_API_KEY=buraya_groq_anahtari

# Fernet sifreleme anahtari — bir kez uretilir, SONRADAN DEGISTIRILMEZ!
# Belgeler bu anahtarla sifrelenir; kaybolursa tum belgeler cozulemez hale gelir.
# Uretmek icin:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=buraya_fernet_anahtari

# Flask oturum/flash mesaj anahtari
# Uretmek icin:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya_gizli_anahtar

# ======================================================================
# BULUT MODU (Render + Neon vb.) — YEREL_MOD kapali
# ======================================================================

# PostgreSQL baglanti adresi.
#   Bulut (Neon):  postgresql://kullanici:sifre@host/neondb?sslmode=require
#   Yerel mod:     ayni satir bu bilgisayardaki veritabanini gosterir (asagidaki bolum).
# SSL yalnizca adreste sslmode yazilirsa uygulanir; yerel PostgreSQL SSL'siz calisir.
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/arcbase

# Render/Docker imaji URETIM=1 ile calisir: debug kapali, cerezler yalnizca HTTPS'te gonderilir.
# Yerelde "python app.py" gelistirme icin bunu bos birakin.
# URETIM=1

# ======================================================================
# YEREL MOD (kurum kurulumu) — ayrintilar: docs/KURULUM_KURUM.md
# Bulut modunda bu bolumu bos birakin; uygulama bugunku gibi calisir.
# ======================================================================

# 1: veritabani bu bilgisayarda ya da yerel agda olmali (localhost, 127.0.0.1,
# 10.x, 172.16-31.x, 192.168.x). Bulut veritabani adresiyle uygulama BASLAMAZ.
# Disariya giden tek baglanti Groq'tur (yalnizca OCR metni gider).
# YEREL_MOD=1

# Yerel modda cerezler duz HTTP'de de gonderilir. Onde TLS saglayan bir sunucu
# (ters vekil) varsa 1 yapin; o zaman cerezler yalnizca HTTPS'te gonderilir.
# HTTPS=1

# Bulut veritabanindan yerele tasima (scripts/veri_tasi.py) icin HEDEF adres.
# Tasima bitince DATABASE_URL bu adresle degistirilir.
# YEREL_DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/arcbase

# Sunucu (sunucu.py / baslat.bat, waitress)
# PORT=5001
# SUNUCU_ADRESI=0.0.0.0        # yalnizca bu bilgisayar icin 127.0.0.1
# SUNUCU_IS_PARCACIGI=8

# Gelen belgeler kutusunu yoneten kullanici; bossa ilk olusturulan kullanici.
# YONETICI_KULLANICI=kullanici_adi

# Izlenen tarama klasoru. Alt klasor = kullanici adi (o kullaniciya ait olur);
# koke dusenler TARAMA_VARSAYILAN_KULLANICI'ya, o da bossa yoneticinin
# "Gelen belgeler" kutusuna gider. Islenen dosya islendi\YYYY-AA-GG altina,
# hatali dosya hata\ altina tasinir; hicbir dosya silinmez.
# TARAMA_KLASORU=C:\ArcBase\Tarama
# TARAMA_VARSAYILAN_KULLANICI=kullanici_adi

# Bu bilgisayara bagli (USB ya da Windows'a eklenmis ag/WSD) tarayicidan dogrudan
# tarama: Windows'ta varsayilan ACIK, ayar gerekmez. Kapatmak icin 0.
# TARAYICI_WIA=0

# Windows'un varsayilan tarama klasorleri (Belgeler\Scanned Documents, Resimler\Scans...)
# ayar gerekmeden izlenir. Kapatmak icin 0. Alinan dosya "ArcBase'e aktarildi" alt
# klasorune tasinir. Tek kullanici varsa onun arsivine, birden fazlaysa yoneticinin
# "Gelen belgeler" kutusuna gider.
# VARSAYILAN_TARAMA_KLASORLERI=0

# "Tarama klasorleri" sayfasinda eklenen/kaldirilan klasorlerin kaydi
# (bossa <uygulama>\veri\izlenen_klasorler.json).
# IZLENEN_KLASORLER_DOSYASI=C:\ArcBase\veri\izlenen_klasorler.json

# Yedekleme (scripts/yedekle.py; Gorev Zamanlayici ile her gun)
# YEDEK_KLASORU=C:\ArcBase\Yedekler
# YEDEK_SAYISI=14
# PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe

# ======================================================================
# TEST — testler CANLI veritabanina ASLA baglanmaz
# ======================================================================

# Testler ve olcum betikleri (docs/hiz_olcumu.py) icin AYRI bir veritabani.
# Tanimli degilse veritabani gerektiren testler atlanir; DATABASE_URL ya da
# YEREL_DATABASE_URL ile ayniysa testler durur.
# TEST_DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/arcbase_test

# Yavas testleri acan bayraklar (varsayilan kapali; ayrintilar: README.md "Testler").
# GERCEK_GROQ=1              # tum paketi gercek Groq ile calistirir (cok istek harcar)
# GROQ_ENTEGRASYON=1         # tests/test_groq_entegrasyon.py (GROQ_API_KEY gerekir)
# TARAYICI_GERCEK_TARA=1     # tests/test_tarayici_wia_gercek.py (camda kagit gerekir)

# ======================================================================
# OPSIYONEL — varsayilanlar cogu kurulum icin uygundur
# ======================================================================

# Kullanilacak Groq modeli (varsayilan: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Tesseract PATH'te degilse tam yolu
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Kullanici basina en fazla belge sayisi (varsayilan: 50)
# KULLANICI_BELGE_LIMITI=50

# Bellek ve baglanti ayarlari (her gunicorn/waitress isleyicisi icin ayri)
# GORSEL_ONBELLEGI_MB=48     # goruntu onbellegi (varsayilan 48)
# HAM_BELLEK_MB=64           # arka plan isine aktarilan ham dosyalar (varsayilan 64)
# DB_HAVUZ_BOYUTU=8          # havuzda bekletilen en fazla bosta baglanti (varsayilan 8)

# 0: arka plan isleme iscisini kapatir (testler isleri kendisi calistirir; normalde ACIK birakin)
# ARKA_PLAN_ISCISI=0

# Dosya boyutu sinirlari ayardan degil koddan gelir (app.py): gorsel 10 MB, PDF 5 MB.
